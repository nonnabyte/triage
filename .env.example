# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# fake = scripted models, no keys needed (tests, CI). real = call the cloud models in configs/models.yaml.
TRIAGE_BACKEND=fake
# Routing version the service runs: baseline | v1 | v2 | v3
TRIAGE_STRATEGY=v2
# true lets the eval harness pick a version per request with the X-Triage-Strategy header
TRIAGE_EVAL_MODE=false
# Fixed reasoning effort for reasoning models in the tiers (Gemini 4 Argon, gpt-oss): low | medium | high.
# Required when a tier uses one; the eval harness sets it per run with --reasoning.
TRIAGE_REASONING=
# Optional: a catalog key that answers every request directly instead of the tiers (eval: --model)
TRIAGE_MODEL=
TRIAGE_LOG_LEVEL=INFO
# Langfuse tracing turns on when the LANGFUSE_* keys below are set. false = off.
TRIAGE_TRACING=true
# false = send only names, tiers, tokens, cost and timings to Langfuse; no prompts or answers
TRIAGE_TRACE_CONTENT=true

# Google Cloud (Vertex AI): Gemini and open "-maas" models
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=

# AWS (Bedrock): long-term Bedrock API key
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-2

# Langfuse (tracing): project Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
